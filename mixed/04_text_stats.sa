# Mixed-syntax program 4: text statistics.
# Python tokenizes, Java counts with a TreeMap and builds bars, JavaScript
# finds the longest words, C++ prints a table with printf.
import java.util.*;

text = """It was the best of times, it was the worst of times, it was the age of
wisdom, it was the age of foolishness, it was the epoch of belief"""

# Python: words, lower-cased, punctuation stripped
def tokenize(s):
    out = []
    for raw in s.split():
        w = raw.strip(",.").lower()
        if w != "":
            out.append(w)
    return out

words = tokenize(text)

// Java: counting and a histogram
public class Stats {
    public static Map<String, Integer> count(List<String> words) {
        Map<String, Integer> counts = new TreeMap<>();
        for (String w : words) counts.put(w, counts.getOrDefault(w, 0) + 1);
        return counts;
    }

    public static String bar(int n) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < n; i++) sb.append('#');
        return sb.toString();
    }
}

Map<String, Integer> counts = Stats.count(words);

// C++: the table of words seen more than once
printf("%-8s %5s  %s\n", "word", "count", "bar");
for (auto w : counts.keySet()) {
    int c = counts.get(w);
    if (c > 1) {
        printf("%-8s %5d  %s\n", w, c, Stats.bar(c));
    }
}

// JavaScript: distinct words by length, longest first, then alphabetical
const distinct = words.filter((w, i) => words.indexOf(w) == i);
const longest = distinct
    .filter(w => w.length >= 6)
    .sort((a, b) => b.length - a.length || (a < b ? -1 : 1));
console.log(`longest words: ${longest.join(" ")}`);

# Python: summary line
unique = len(counts.keySet())
print(f"{len(words)} words, {unique} distinct, top word: 'was' x{counts.get('was')}")
