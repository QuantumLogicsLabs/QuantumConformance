# Mixed-syntax program 1: an inventory report.
# Java classes hold the data, Python computes, JavaScript filters, C++ prints.
import java.util.*;

// ── Java: the model ──
public class Item implements Comparable<Item> {
    private final String name;
    private final int quantity;
    private final double price;

    public Item(String name, int quantity, double price) {
        this.name = name;
        this.quantity = quantity;
        this.price = price;
    }

    public String getName() { return name; }
    public int getQuantity() { return quantity; }
    public double getPrice() { return price; }
    public double value() { return quantity * price; }

    @Override
    public int compareTo(Item other) { return name.compareTo(other.name); }

    @Override
    public String toString() { return String.format("%s x%d", name, quantity); }
}

# ── Python: build and summarise ──
def make_stock():
    rows = [("widget", 12, 2.5), ("gadget", 3, 19.99), ("doohickey", 0, 7.25), ("gizmo", 40, 0.75)]
    return [new Item(r[0], r[1], r[2]) for r in rows]

def total_value(items):
    total = 0
    for it in items:
        total += it.value()
    return total

stock = make_stock()

// ── JavaScript: filter and transform ──
const inStock = stock.filter(it => it.getQuantity() > 0);
const names = inStock.map(it => it.getName().toUpperCase());
console.log(`in stock: ${names.join(", ")}`);

// ── C++: the report ──
void printRow(string name, int qty, double value) {
    cout << name << ": " << qty << " units, worth " << value << endl;
}

for (auto it : inStock) {
    printRow(it.getName(), it.getQuantity(), it.value());
}

// ── Java: sorting and aggregates ──
List<Item> sorted = new ArrayList<>(stock);
Collections.sort(sorted);
System.out.println("sorted: " + sorted);
Item cheapest = Collections.min(stock, Comparator.comparingDouble(Item::getPrice));
System.out.printf("cheapest: %s at %.2f%n", cheapest.getName(), cheapest.getPrice());
System.out.printf("total value: %.2f%n", total_value(stock));
